{
  "name": "dsh-telegram-bot",
  "version": "0.2.2",
  "description": "Telegram sessions, topics, model controls and approvals for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "dsh-telegram-send": "./bin/dsh-telegram-send.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    ".\"": "./index.js"
  },
  "files": [
    "bin",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CREDITS.md",
    "docs",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "telegramify-markdown": "^1.3.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "telegram",
    "bot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boobaw/dsh-telegram-bot.git"
  },
  "homepage": "https://github.com/Boobaw/dsh-telegram-bot#readme",
  "bugs": {
    "url": "https://github.com/Boobaw/dsh-telegram-bot/issues"
  },
  "scripts": {
    "test": "NODE_ENV=test DSH_HOME=\"$(mktemp -d)\" node --test --test-concurrency=1"
  }
}
